DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ADMIN_API_TOKEN=
MCP_BEARER_TOKEN=
ENABLE_AI_INVESTIGATIONS=false
MAX_DAILY_INVESTIGATIONS=5
PORT=3000
NODE_ENV=development
# Exact public origin, required in production. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
EVIDENCE_WINDOW_MINUTES=60
AI_TIMEOUT_MS=25000
# Optional PEM CA path from Supabase Database settings; default uses system trust.
DATABASE_CA_PATH=
# For Railway: complete multiline PEM certificate, supplied in service Variables.
# Configure either DATABASE_CA_PATH or DATABASE_CA_CERT, not both.
DATABASE_CA_CERT=
